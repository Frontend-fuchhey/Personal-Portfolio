rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User admin collection (read to verify admin privileges)
    match /users/{email} {
      allow read: if true;
      allow write: if false;
    }

    // Config & Settings collection for passkey storage
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // NOTE: the admin panel may be unlocked via Google sign-in OR a passkey (passkey sessions have no
    // Firebase Auth identity), so request.auth cannot gate these writes. The admin gate is enforced in the UI.
    // Tighten (e.g. App Check / Cloud Function) if you move to Auth-only admin.

    // Projects: Public read for portfolio visitors, write allowed for admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Photos: Public read for gallery moments, write allowed for admin
    match /photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
